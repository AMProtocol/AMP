{
  "name": "@agent-manifest/mcp-server",
  "version": "0.1.1",
  "mcpName": "com.agent-manifest/amp-mcp",
  "description": "Official MCP server for the Agent Manifest Protocol (AMP) — discover, validate, and check agent permissions against agent-manifest.json",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "amp-mcp": "./dist/index.js",
    "amp-mcp-http": "./dist/http.js"
  },
  "files": [
    "dist",
    "schemas",
    "smithery.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/http.ts",
    "dev:stdio": "tsx src/index.ts",
    "start": "node dist/http.js",
    "start:stdio": "node dist/index.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-manifest",
    "amp",
    "agent-manifest-protocol",
    "smithery"
  ],
  "author": "Brandon Weber <brandon@agent-manifest.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AMProtocol/AMP.git",
    "directory": "amp-mcp"
  },
  "homepage": "https://agent-manifest.com",
  "bugs": {
    "url": "https://github.com/AMProtocol/AMP/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "express": "^4.21.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
